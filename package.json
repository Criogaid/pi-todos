{
	"name": "@criogaid/pi-todos",
	"private": true,
	"version": "0.1.0",
	"description": "Pi extension. A todo list for the model, rendered as a live overlay that survives /reload and conversation compaction.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"todo"
	],
	"type": "module",
	"license": "MIT",
	"author": "Kripto",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Criogaid/pi-todos.git"
	},
	"homepage": "https://github.com/Criogaid/pi-todos#readme",
	"bugs": {
		"url": "https://github.com/Criogaid/pi-todos/issues"
	},
	"scripts": {
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"format": "biome check --write .",
		"test": "vitest run"
	},
	"files": [
		"src/",
		"!src/**/*.test.ts",
		"LICENSE",
		"docs/",
		"!docs/*.png",
		"!docs/*.jpg",
		"!docs/*.svg",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@earendil-works/pi-ai": "0.99.2",
		"@earendil-works/pi-coding-agent": "0.99.2",
		"@earendil-works/pi-tui": "0.99.2",
		"@types/node": "22.20.1",
		"typebox": "1.3.27",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=11.0.0"
	}
}
